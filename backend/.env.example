# ==========================================
# HIREFLOW BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# 1. DATABASE & JWT AUTHENTICATION
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hireflow?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 2. FRONTEND URL (For CORS policies)
FRONTEND_URL=https://your-hireflow-frontend.vercel.app

# 3. LLM API KEYS (PRIMARY: GROQ, SECONDARY: AWS BEDROCK)
GROQ_API_KEY=gsk_your_groq_api_key_here
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1

# 4. AWS S3 STORAGE (Resume PDFs)
AWS_S3_BUCKET_NAME=hireflow-resumes-bucket

# 5. GMAIL SMTP (Interview Notifications & Calendar Invitations)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
